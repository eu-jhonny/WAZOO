// ============================================================
// Wazoo Pet Express — Schema Prisma (PostgreSQL / Supabase)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Usuários / Admins ────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

// ── Categorias ───────────────────────────────────────────────
model Category {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  icon     String?
  gradient String?
  petType  String? // "cachorro" | "gato" | null
  order    Int     @default(0)
  active   Boolean @default(true)

  @@map("categories")
}

// ── Produtos ─────────────────────────────────────────────────
model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  categorySlug     String
  shortDescription String
  description      String   @db.Text
  price            Float
  comparePrice     Float?
  promoLabel       String?
  image            String   @default("")
  gallery          String[]
  audience         String   @default("ambos") // "cachorro" | "gato" | "ambos"
  size             String   @default("todos")
  leadTime         String   @default("5-7 dias úteis")
  availability     String   @default("Disponível sob encomenda")
  tags             String[]
  active           Boolean  @default(true)
  featured         Boolean  @default(false)
  onDemand         Boolean  @default(true)
  stock            Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orderItems  OrderItem[]
  promotions  ProductPromotion[]

  @@map("products")
}

// ── Kits ─────────────────────────────────────────────────────
model Kit {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @db.Text
  price       Float
  comparePrice Float?
  image       String   @default("")
  accent      String   @default("orange")
  items       String[]
  audience    String   @default("ambos")
  leadTime    String   @default("7-10 dias úteis")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]

  @@map("kits")
}

// ── Pedidos ──────────────────────────────────────────────────
model Order {
  id     String @id @default(cuid())
  number String @unique // ex: WZ-2024-001

  // Status
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  // Cliente
  customerName  String
  customerEmail String
  customerPhone String
  customerDoc   String? // CPF

  // Entrega
  deliveryMethod      String  @default("DELIVERY") // DELIVERY | PICKUP
  addressStreet       String?
  addressNumber       String?
  addressComplement   String?
  addressNeighborhood String?
  addressCity         String?
  addressState        String?
  addressZip          String?

  // Valores
  subtotal       Float
  discountAmount Float  @default(0)
  shippingAmount Float  @default(0)
  total          Float
  couponCode     String?

  // Pagamento MercadoPago
  paymentMethod  String? // credit_card | debit_card | pix | boleto
  mpPaymentId    String? // ID retornado pelo MP
  mpPreferenceId String?
  pixCode        String? @db.Text
  boletoUrl      String?
  paidAt         DateTime?

  // Notas
  customerNote String?  @db.Text
  adminNote    String?  @db.Text

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("orders")
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String?
  kitId      String?
  name       String
  quantity   Int
  unitPrice  Float
  totalPrice Float
  image      String  @default("")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  kit     Kit?     @relation(fields: [kitId], references: [id])

  @@map("order_items")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  IN_PROCESS
}

// ── Avaliações ───────────────────────────────────────────────
model Review {
  id        String   @id @default(cuid())
  name      String
  email     String?
  petName   String?
  rating    Int      // 1-5
  text      String   @db.Text
  approved  Boolean  @default(false)
  featured  Boolean  @default(false)
  productId String?
  createdAt DateTime @default(now())

  @@map("reviews")
}

// ── Cupons ───────────────────────────────────────────────────
model Coupon {
  id         String    @id @default(cuid())
  code       String    @unique
  type       CouponType
  value      Float
  minOrder   Float?
  maxUses    Int?
  usedCount  Int       @default(0)
  active     Boolean   @default(true)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@map("coupons")
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

// ── Banners ──────────────────────────────────────────────────
model Banner {
  id        String   @id @default(cuid())
  image     String?
  fallback  String   @default("from-orange-400 to-orange-600")
  tag       String?
  title     String
  subtitle  String?
  cta       String   @default("Ver mais")
  ctaStyle  String?
  link      String   @default("/produtos")
  category  String   @default("geral") // geral | cachorros | gatos | copa | festas
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("banners")
}

// ── Promoções ────────────────────────────────────────────────
model Promotion {
  id          String        @id @default(cuid())
  title       String
  description String?
  type        PromotionType
  value       Float
  startDate   DateTime
  endDate     DateTime
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())

  products ProductPromotion[]

  @@map("promotions")
}

model ProductPromotion {
  productId   String
  promotionId String
  product     Product   @relation(fields: [productId], references: [id])
  promotion   Promotion @relation(fields: [promotionId], references: [id])

  @@id([productId, promotionId])
  @@map("product_promotions")
}

enum PromotionType {
  PERCENTAGE
  FIXED
  BOGO // Compre 2, pague 1
}

// ── Configurações da loja ────────────────────────────────────
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ── Newsletter ───────────────────────────────────────────────
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}
