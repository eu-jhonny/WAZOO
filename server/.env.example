# ============================================================
# Wazoo API — Variáveis de Ambiente
# Copie para .env e preencha os valores
# ============================================================

# Servidor
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# Banco de dados (PostgreSQL — Supabase gratuito)
# Pegue em: https://supabase.com → Settings → Database → Connection String
DATABASE_URL="postgresql://postgres:[senha]@db.[ref].supabase.co:5432/postgres"

# JWT (gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=sua_chave_secreta_aqui_muito_longa_e_aleatoria
JWT_EXPIRES_IN=7d
REFRESH_SECRET=outra_chave_secreta_refresh_token
REFRESH_EXPIRES_IN=30d

# Admin inicial (criado no seed)
ADMIN_EMAIL=admin@wazoo.com.br
ADMIN_PASSWORD=WazooAdmin2024!

# MercadoPago (https://www.mercadopago.com.br/developers/pt/docs)
# Crie conta em: https://www.mercadopago.com.br/developers/panel
MP_ACCESS_TOKEN=APP_USR-xxxx-xxxx-xxxx-xxxx
MP_PUBLIC_KEY=APP_USR-xxxx-xxxx
# URL que o MP vai chamar quando o pagamento mudar de status
MP_WEBHOOK_SECRET=seu_webhook_secret_aqui

# Cloudinary (imagens — https://cloudinary.com — gratuito 10GB)
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# E-mail (opcional — para notificações)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua_senha_de_app
EMAIL_FROM="Wazoo Pet Express <seuemail@gmail.com>"

# WhatsApp (número sem formatação, ex: 5511999999999)
WHATSAPP_NUMBER=5511999999999

# CORS — domínios permitidos (separados por vírgula)
ALLOWED_ORIGINS=http://localhost:5173,https://seusite.vercel.app
