# ============================================================
# Wazoo Frontend — Variáveis de Ambiente
# ============================================================
# Para o e-commerce REAL, VITE_API_URL deve apontar para a API Wazoo.
# Sem ela, o frontend mantém apenas o modo local de desenvolvimento.

# ── API principal (obrigatória em produção) ────────────────
# Ex.: https://wazoo-api.onrender.com
VITE_API_URL=https://sua-api-wazoo.com

# ── Mercado Pago ────────────────────────────────────────────
# Chave pública — pode ficar no frontend.
# O Access Token e o Webhook Secret ficam SOMENTE no backend.
VITE_MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxxxx

# ── Login social (opcional) ────────────────────────────────
# Enquanto o OAuth não estiver conectado à API principal,
# o login por e-mail/senha é o fluxo oficial de produção.
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com

# ── Integrações legadas / fallback local ───────────────────
# O Supabase abaixo só é utilizado como fallback quando VITE_API_URL
# NÃO está configurada. Não é necessário para a arquitetura principal.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# O fluxo antigo de PIX automático via /api/pix não é o fluxo principal.
# Pagamentos reais passam pela API Wazoo + Mercado Pago.
VITE_PAYMENTS_AUTO=false

# E-mail pelo navegador também é legado/fallback.
# Em produção, prefira SMTP no backend.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAIL_API_URL=
