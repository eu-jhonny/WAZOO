# URL da API backend (local ou Render)
VITE_API_URL=http://localhost:3001

# Chave pública do MercadoPago (começa com APP_USR)
# Obtenha em: https://www.mercadopago.com.br/developers/panel
VITE_MP_PUBLIC_KEY=APP_USR-xxxxxxxxxxxx-xxxxxx-xxxx
