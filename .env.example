# ============================================================
# Wazoo Frontend — Variáveis de Ambiente
# Copie para .env.local e preencha
# ============================================================

# URL da API backend (local ou Render)
VITE_API_URL=http://localhost:3001

# Chave pública do MercadoPago (começa com APP_USR)
# Obtenha em: https://www.mercadopago.com.br/developers/panel
VITE_MP_PUBLIC_KEY=APP_USR-xxxxxxxxxxxx-xxxxxx-xxxx

# Google OAuth Client ID
# Obtenha em: https://console.cloud.google.com → Credenciais → ID do cliente OAuth 2.0
# Adicione nas "Origens JavaScript autorizadas": https://seu-site.vercel.app e http://localhost:5173
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
